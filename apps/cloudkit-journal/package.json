{
    "name": "@party-stack/cloudkit-journal",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "index.ts",
    "expo": {
        "autolinking": {
            "searchPaths": [
                "../../node_modules",
                "./node_modules"
            ],
            "nativeModulesDir": "../../packages"
        }
    },
    "scripts": {
        "build": "tsc --noEmit",
        "dev": "expo start --dev-client",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "cloudkit:schema": "tsx scripts/generate-cloudkit-schema.ts",
        "cloudkit:setup": "cloudkit-ontology setup --schema cloudkit-schema.ckdb",
        "lint": "eslint",
        "test": "vitest run --pass-with-no-tests"
    },
    "dependencies": {
        "@party-stack/cloudkit-client": "workspace:*",
        "@party-stack/cloudkit-client-expo": "workspace:*",
        "@party-stack/cloudkit-client-http": "workspace:*",
        "@party-stack/cloudkit-ontology": "workspace:*",
        "@party-stack/expo-runtime": "workspace:*",
        "@party-stack/ontology": "workspace:*",
        "@party-stack/web-runtime": "workspace:*",
        "@react-native-community/netinfo": "^12.0.1",
        "@tanstack/db": "^0.6.14",
        "@tanstack/react-db": "^0.1.92",
        "expo": "^55.0.23",
        "expo-dev-client": "^55.0.13",
        "expo-document-picker": "^55.0.8",
        "expo-file-system": "^55.0.19",
        "expo-sqlite": "^55.0.15",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-native": "0.83.6",
        "react-native-get-random-values": "^1.11.0",
        "react-native-web": "^0.21.2"
    },
    "devDependencies": {
        "@bobbyfidz/universal-build-config": "^0.1.1",
        "@expo/ngrok": "^4.1.3",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.6",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.25.0",
        "tsx": "^4.20.6",
        "typescript": "~5.8.3",
        "vitest": "^3.1.1"
    }
}
