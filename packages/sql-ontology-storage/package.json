{
    "name": "@party-stack/sql-ontology-storage",
    "version": "0.1.0",
    "files": [
        "lib"
    ],
    "type": "module",
    "exports": {
        "./sqlite": {
            "types": "./lib/sqlite.d.ts",
            "default": "./lib/sqlite.js"
        },
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./tables": {
            "types": "./lib/tables.d.ts",
            "default": "./lib/tables.js"
        }
    },
    "dependencies": {
        "@party-stack/ontology-storage": "workspace:*"
    },
    "devDependencies": {
        "@effect/sql-pg": "^4.0.5",
        "@effect/sql-pglite": "^4.0.5",
        "@effect/sql-sqlite-node": "^4.0.5",
        "@party-stack/build-config": "workspace:*",
        "@party-stack/ontology-backend": "workspace:*",
        "@party-stack/ontology-spec": "workspace:*",
        "@testcontainers/postgresql": "^12.2.1",
        "effect": "^4.0.5",
        "typescript": "~7.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "effect": "^4.0.5"
    }
}
