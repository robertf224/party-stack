{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "party-stack-cloudflare-runtime-fixture",
    "main": "fixtures/worker.ts",
    "compatibility_date": "2026-08-27",
    "durable_objects": {
        "bindings": [
            {
                "name": "CELLS",
                "class_name": "OntologyFixtureDurableObject",
            },
        ],
    },
    "r2_buckets": [
        {
            "binding": "BLOBS",
            "bucket_name": "party-stack-runtime-fixture",
        },
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["OntologyFixtureDurableObject"],
        },
    ],
}
