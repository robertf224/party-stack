    },
    "devDependencies": {
        "@party-stack/build-config": "workspace:*",
        "@react-native-community/netinfo": "^12.0.1",
        "expo": "^57.0.29",
        "expo-file-system": "^57.0.7",
        "expo-sqlite": "^57.0.4",
        "typescript": "~7.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@react-native-community/netinfo": "^12.0.1",
        "expo": "^57.0.29",
        "expo-file-system": "^57.0.7",
