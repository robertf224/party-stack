{
    "name": "@party-stack/salesforce-client",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "tsc",
        "demo": "pnpm --filter @party-stack/salesforce-task-manager demo",
        "lint": "eslint",
        "smoke": "pnpm turbo run build --filter @party-stack/salesforce-client && node --env-file-if-exists=.env scripts/smoke.mjs",
        "test": "vitest run --pass-with-no-tests"
    },
    "dependencies": {
        "@bobbyfidz/panic": "^0.1.0",
        "@jsforce/jsforce-node": "^3.10.19"
    },
    "devDependencies": {
        "@bobbyfidz/universal-build-config": "^0.1.1",
        "@party-stack/node-runtime": "workspace:^",
        "@party-stack/oauth": "workspace:^",
        "eslint": "^9.25.0",
        "open": "^11.0.1",
        "typescript": "~5.8.3",
        "vitest": "^3.1.1"
    }
}
