# External Client App consumer key. This is the OAuth client ID, not the secret.
SALESFORCE_CLIENT_ID=

# Prefer your org's My Domain URL for both values.
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_LOGIN_URL=https://your-domain.my.salesforce.com

# This must exactly match the External Client App callback URL.
SALESFORCE_REDIRECT_URL=http://localhost:1717/oauth/callback
SALESFORCE_API_VERSION=65.0
