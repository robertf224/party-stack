{
    "name": "@party-stack/ontology",
    "version": "0.20.0",
    "bin": {
        "ontology": "./lib/cli/index.js"
    },
    "files": [
        "lib"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./utils": {
            "types": "./lib/utils/index.d.ts",
            "default": "./lib/utils/index.js"
        },
        "./json": {
            "types": "./lib/json/index.d.ts",
            "default": "./lib/json/index.js"
        },
        "./values": {
            "types": "./lib/utils/values.d.ts"
        },
        "./testing/sqlite": {
            "types": "./lib/testing/sqlite.d.ts",
            "default": "./lib/testing/sqlite.js"
        },
        "./testing/sqliteBackend": {
            "types": "./lib/testing/sqliteBackend.d.ts",
            "default": "./lib/testing/sqliteBackend.js"
        },
        "./tanstack": {
            "types": "./lib/tanstack/index.d.ts",
            "default": "./lib/tanstack/index.js"
        },
        "./query": {
            "types": "./lib/query.d.ts",
            "default": "./lib/query.js"
        }
    },
    "scripts": {
        "bootstrap": "pnpm --filter @party-stack/ontology-spec bootstrap",
        "generate:examples": "tsx ./src/cli/index.ts generate --ontology ./src/examples/blog.ts --outDir ./src/examples/generated --namespace Blog",
        "generate:meta": "pnpm --filter @party-stack/ontology-spec generate:meta",
        "ontology": "tsx ./src/cli/index.ts"
    },
    "dependencies": {
        "@bobbyfidz/panic": "^0.1.0",
        "@next/env": "^16.1.6",
        "@party-stack/connect": "workspace:*",
        "@party-stack/node-runtime": "workspace:*",
        "@party-stack/ontology-backend": "workspace:*",
        "@party-stack/ontology-replica": "workspace:*",
        "@party-stack/ontology-spec": "workspace:*",
        "@party-stack/ontology-storage": "workspace:*",
        "@party-stack/runtime": "workspace:*",
        "@party-stack/sql-ontology-storage": "workspace:*",
        "change-case": "^5.4.4",
        "commander": "^14.0.2",
        "effect": "^4.0.5",
        "image-dimensions": "^2.5.1",
        "jiti": "^2.6.1",
        "temporal-polyfill": "^0.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@party-stack/build-config": "workspace:*",
        "@tanstack/db": "0.14.0",
        "better-sqlite3": "^12.9.0",
        "tsx": "^4.20.6",
        "typescript": "~7.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@tanstack/db": "0.14.0"
    }
}
